<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F5F5">

        <!-- Header com logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1565C0"
            android:padding="10dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="42dp"
                android:src="@drawable/school_identity"
                android:scaleType="fitCenter"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Painel Admin"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Senha"
                android:textSize="11sp"
                android:backgroundTint="#0D47A1"/>
        </LinearLayout>

        <!-- Linha 1: Salvar | Modo Aluno | Inicio | Remover -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="#E3F2FD">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Salvar"
                android:textSize="12sp"
                android:backgroundTint="#1565C0"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnStudentMode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Modo Aluno"
                android:textSize="12sp"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Inicio"
                android:textSize="12sp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="3dp"/>

            <Button
                android:id="@+id/btnRemoveOwner"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Remover"
                android:textSize="12sp"
                android:backgroundTint="#4A4A4A"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Contador -->
        <TextView
            android:id="@+id/tvAllowedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 app(s) liberado(s)"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:background="#FFFFFF"/>

        <!-- Linha 2: Busca -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Buscar app..."
            android:padding="8dp"
            android:background="#F0F0F0"
            android:inputType="text"/>

        <!-- Linha 3: Todos | Nenhum | Atualizar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:background="#FAFAFA">

            <Button
                android:id="@+id/btnSelectAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Selecionar Todos"
                android:textSize="11sp"
                android:backgroundTint="#42A5F5"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnDeselectAll"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Desmarcar Todos"
                android:textSize="11sp"
                android:backgroundTint="#90A4AE"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Atualizar Lista"
                android:textSize="11sp"
                android:backgroundTint="#FB8C00"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marque os apps que os alunos podem usar:"
            android:textSize="12sp"
            android:textColor="#757575"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF"/>

    </LinearLayout>

    <!-- Overlay de carregamento (ativando modo aluno) -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#CC1A237E"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ativando Modo Aluno..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ocultando apps não autorizados"
            android:textColor="#BBDEFB"
            android:textSize="13sp"/>

    </LinearLayout>

</FrameLayout>
